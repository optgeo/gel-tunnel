# Ignore downloaded data files
data/
!data/.gitkeep

# Ignore system files
.DS_Store
Thumbs.db

# Ignore temporary files
*.tmp
*.swp

# Ignore logs
*.log

# Ignore compiled files
*.o
*.out
*.class

# Ignore Python cache
__pycache__/
*.pyc

# Ignore node_modules
node_modules/

# Ignore environment files
.env
.env.*

# Ignore pmtiles files in data folder
data/*.pmtiles
